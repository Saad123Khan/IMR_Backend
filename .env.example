# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=remit_db2

# Database Options (Development vs Production)
DB_SYNCHRONIZE=true   # Set to 'false' in production, use migrations instead
DB_LOGGING=true       # Set to 'false' in production to prevent sensitive data leaks

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# Migration & Database Management
# Development: DB_SYNCHRONIZE=true (auto-sync entities)
# Production: DB_SYNCHRONIZE=false (use migrations)
#
# Migration Commands:
# - npm run migration:generate   # Generate from entity changes
# - npm run migration:run                           # Run pending migrations
# - npm run migration:revert                        # Revert last migration
# - npm run migration:show                          # Show migration status
#
# Security Notes:
# 1. Generate strong JWT_SECRET: openssl rand -base64 64
# 2. Never commit actual .env file to git
# 3. Set DB_SYNCHRONIZE=false in production
# 4. Set DB_LOGGING=false in production
# 5. Always use migrations for schema changes in production
